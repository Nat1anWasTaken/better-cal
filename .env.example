# Copy to .env and replace every value marked CHANGE-ME.
# Generate secrets with:  openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE-ME
RUNNER_TOKEN=CHANGE-ME-at-least-24-random-characters

# Host port for the web UI / API.
APP_PORT=8080
# Comma-separated browser origins allowed to make cookie-authenticated writes,
# e.g. https://judge.example.org (leave empty to only rely on the CSRF token).
PUBLIC_ORIGINS=
# The site's public URL, e.g. https://judge.example.org. Required for MCP
# (it is the OAuth issuer); MCP stays off while this is empty.
PUBLIC_URL=
# Header the reverse proxy puts the real client IP in, used for rate limits.
# Behind Cloudflare: cf-connecting-ip. Empty: the last X-Forwarded-For hop.
CLIENT_IP_HEADER=
# Playground runs sent to the runner at once (shared with judging).
PLAYGROUND_CONCURRENCY=2
# Set to true when served over HTTPS (recommended in production).
COOKIE_SECURE=false

# Parallel sandboxes (and judge workers). ~1 per CPU core is reasonable.
RUNNER_CONCURRENCY=2
RUNNER_MEM_LIMIT=1g
